{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Cấu hình top-level dùng cho development/local.
	"name": "workout-tracker-api-development",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-06",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	/*
   * Development:
   * Khi chạy `npx wrangler dev`, Wrangler mô phỏng D1 ở local
   * vì remote đang là false.
   *
   * Ta trỏ tên cấu hình tới DB staging thay vì production để
   * hạn chế rủi ro nếu sau này chạy nhầm lệnh remote.
   */
	"d1_databases": [
		{
			"binding": "workout_tracker_db",
			"database_name": "workout-tracker-db-staging",
			"database_id": "THAY_BANG_STAGING_DATABASE_ID",
			"remote": false
		}
	],
	"vars": {
		"APP_NAME": "Workout Tracker Development",
		"AUTHOR": "Thuy",
		"ENVIRONMENT": "development"
	},
	"env": {
		/*
     * STAGING
     */
		"staging": {
			"name": "workout-tracker-api-staging",
			"d1_databases": [
				{
					"binding": "workout_tracker_db",
					"database_name": "workout-tracker-db-staging",
					"database_id": "5b7cec2e-bdd6-42a9-9141-c155c5aa458a"
				}
			],
			"vars": {
				"APP_NAME": "Workout Tracker Staging",
				"AUTHOR": "Thuy",
				"ENVIRONMENT": "staging"
			}
		},
		/*
     * PRODUCTION
     *
     * Giữ tên my-first-worker để không làm thay đổi Worker
     * production hiện tại của bạn.
     */
		"production": {
			"name": "my-first-worker",
			"d1_databases": [
				{
					"binding": "workout_tracker_db",
					"database_name": "workout-tracker-db",
					"database_id": "0b586f37-df9c-4bb3-8a96-97ddb754bc23"
				}
			],
			"vars": {
				"APP_NAME": "Workout Tracker",
				"AUTHOR": "Thuy",
				"ENVIRONMENT": "production"
			}
		}
	}
}